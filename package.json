{
  "name": "sarahui-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Original sarahUI design system by MASARA X",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:components": "node --test packages/ui/src/components/*/*.test.mjs",
    "check": "npm run build && node scripts/check-components.mjs && npm test && npm run test:components",
    "test:browser": "node tests/browser.mjs",
    "test:package": "node scripts/check-package.mjs",
    "pack:ui": "npm run build && npm run test:package",
    "typecheck": "tsc --noEmit",
    "publish:verified": "node scripts/publish-package.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "playwright": "1.62.1",
    "tailwindcss": "^4.3.4",
    "typescript": "5.9.3"
  }
}
