{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "packages/ui/src/**/*.d.ts",
    "tokens/generated/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "read_ui"
  ]
}

